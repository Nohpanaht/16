<?php
class Employee {
    public $name;
    public $position;
    public $salary;

    public function __construct($name, $position, $salary) {
        $this->name = $name;
        $this->position = $position;
        $this->salary = $salary;
    }

    public function showInfo() {
        echo "Employee Name : " . $this->name . "<br>";
        echo "Position : " . $this->position . "<br>";
        echo "Salary : " . $this->salary . "<br>";
        echo "Bonus : " . $this->calculateBonus() . "<br><br>";
    }

    public function calculateBonus() {
        return $this->salary * 0.10;
    }
}

$employee1 = new Employee("Somchai", "Programmer", 30000);
$employee2 = new Employee("Suda", "Designer", 25000);

$employee1->showInfo();
$employee2->showInfo();
?>
